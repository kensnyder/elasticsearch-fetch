{
  "name": "elasticsearch-fetch",
  "version": "1.1.0",
  "description": "A lightweight, fetch-based alternative to the heavy Elasticsearch SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "require": "./dist/functions.cjs",
      "import": "./dist/functions.mjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensnyder/elasticsearch-fetch.git"
  },
  "keywords": [
    "Elasticsearch Client",
    "Elasticsearch SDK",
    "Elasticsearch Fetch",
    "Elasticsearch Lightweight",
    "Elasticsearch",
    "Elastic",
    "@elastic/elasticearch",
    "ES Client"
  ],
  "scripts": {
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "test": "bun test ./src/",
    "test-watch": "bun test --watch ./src/",
    "build": "bun run build:clean && bun run build:generate && bun run build:functions:entry && bun run build:dts && bun run build:esm && bun run build:cjs && bun run build:gzip-size",
    "build:clean": "rm -rf dist/ && mkdir dist",
    "build:generate": "bun run scripts/generate.ts",
    "build:functions:entry": "bun run scripts/build-functions-entry.ts",
    "build:dts": "bun run build:dts:link && bun run build:dts:index && bun run build:dts:functions",
    "build:dts:link": "mkdir -p node_modules/dts-bundle-generator/node_modules && ln -sfn ../../typescript-5 node_modules/dts-bundle-generator/node_modules/typescript",
    "build:dts:index": "yes | bunx dts-bundle-generator --no-check --project tsconfig.bundle-generator.json -o dist/index.d.ts ./index.ts",
    "build:dts:functions": "yes | bunx dts-bundle-generator --no-check --project tsconfig.bundle-generator.functions.json -o dist/functions.d.ts ./.functions-entry.ts",
    "build:esm": "bun run build:esm:index && bun run build:esm:functions",
    "build:esm:index": "bunx esbuild ./index.ts --bundle --platform=node --format=esm --packages=external --minify --outfile=dist/index.mjs",
    "build:esm:functions": "bunx esbuild ./.functions-entry.ts --bundle --platform=node --format=esm --packages=external --minify --outfile=dist/functions.mjs",
    "build:cjs": "bun run build:cjs:index && bun run build:cjs:functions",
    "build:cjs:index": "bunx esbuild ./index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/index.cjs",
    "build:cjs:functions": "bunx esbuild ./.functions-entry.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/functions.cjs",
    "build:gzip-size": "echo 'gzipped savings and size:' && gzip -cv dist/index.mjs | wc -c && gzip -cv dist/functions.mjs | wc -c",
    "coverage": "bun test --coverage --coverage-reporter=lcov ./src/",
    "view-coverage": "open ./coverage/index.html"
  },
  "author": "Ken Snyder <kendsnyder@gmail.com>",
  "license": "ISC",
  "peerDependencies": {
    "@elastic/elasticsearch": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@elastic/elasticsearch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@elastic/elasticsearch": "^9.5.1",
    "bun-types": "1.4.0",
    "dts-bundle-generator": "9.5.1",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
